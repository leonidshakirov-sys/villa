---
import { property } from "../config/property";
import { formatPrice } from "../lib/format";

const rows = [
  { label: "Площадь дома", value: property.areaLabel },
  { label: "Площадь участка", value: property.landAreaLabel },
  { label: "Количество этажей", value: String(property.floors) },
  { label: "Год постройки", value: String(property.yearBuilt) },
  { label: "Материал", value: property.wallsShort },
  { label: "Коммуникации", value: property.communications },
  { label: "Гараж", value: "есть" },
  { label: "Помещение под сауну", value: "есть" },
  { label: "Расстояние до МКАД", value: property.distanceToMkad },
  { label: "Продажа", value: "от собственника" },
];

if (typeof property.price === "number") {
  rows.splice(0, 0, { label: "Цена", value: formatPrice(property.price) });
}
---

<section class="section specs" id="specs" aria-labelledby="specs-title">
  <div class="container">
    <p class="eyebrow">Параметры</p>
    <h2 id="specs-title">Основные характеристики</h2>
    <dl>
      {
        rows.map((row) => (
          <div class="row">
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  h2 {
    margin-bottom: var(--space-6);
    font-size: var(--text-4xl);
  }

  dl {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--color-line);
  }

  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  dt {
    color: var(--color-stone);
    font-size: 0.92rem;
  }

  dd {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  @media (min-width: 720px) {
    .row {
      grid-template-columns: 1fr 1fr;
      align-items: baseline;
    }

    dd {
      text-align: right;
    }
  }
</style>
