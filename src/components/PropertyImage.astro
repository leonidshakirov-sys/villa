---
import { categoryLabels, type PropertyImage as PropertyImageType } from "../config/property";
import { resolvePictureSources } from "../lib/files";

interface Props {
  image: PropertyImageType;
  class?: string;
  priority?: boolean;
  sizes?: string;
}

const { image, class: className = "", priority = false, sizes = "100vw" } = Astro.props;
const sources = resolvePictureSources(image.src);
const category = categoryLabels[image.category];
const fileName = image.src.split("/").pop() ?? "";
---

{
  sources.exists ? (
    <picture class={className}>
      {sources.avif && <source type="image/avif" srcset={sources.avif} sizes={sizes} />}
      {sources.webp && <source type="image/webp" srcset={sources.webp} sizes={sizes} />}
      <img
        src={sources.raster ?? sources.webp ?? sources.avif}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading={priority ? "eager" : "lazy"}
        decoding={priority ? "sync" : "async"}
        fetchpriority={priority ? "high" : "low"}
        sizes={sizes}
      />
    </picture>
  ) : (
    <div
      class:list={["placeholder", className]}
      role="img"
      aria-label={`${image.alt}. Фотография будет добавлена.`}
      style={`aspect-ratio: ${image.width} / ${image.height}`}
    >
      <div class="placeholder-inner">
        <span class="placeholder-kicker">{category}</span>
        <span class="placeholder-title">{image.alt}</span>
        <span class="placeholder-hint">Загрузите {fileName}</span>
      </div>
    </div>
  )
}

<style>
  picture,
  img {
    width: 100%;
    height: 100%;
  }

  img {
    object-fit: cover;
  }
</style>
