---
import PropertyImage from "./PropertyImage.astro";
import { categoryLabels, property, type ImageCategory } from "../config/property";

const images = property.images;
const preview = images.slice(0, 5);
const usedCategories = [...new Set(images.map((image) => image.category))] as ImageCategory[];
---

<section class="section gallery" id="gallery" aria-labelledby="gallery-title">
  <div class="container-wide">
    <div class="intro">
      <p class="eyebrow">Фотографии</p>
      <h2 id="gallery-title">Дом в фотографиях</h2>
      <p class="lead">Реальные кадры объекта. Нажмите на снимок, чтобы открыть его крупно.</p>
    </div>

    <div class="filters" role="group" aria-label="Категории фотографий">
      <button type="button" class="filter is-active" data-filter="all" aria-pressed="true">
        Все
      </button>
      {
        usedCategories.map((category) => (
          <button type="button" class="filter" data-filter={category} aria-pressed="false">
            {categoryLabels[category]}
          </button>
        ))
      }
    </div>

    <div class="mosaic">
      {
        preview.map((image, index) => (
          <button
            class:list={["tile", index === 0 && "tile-main"]}
            type="button"
            data-open-gallery={index}
            data-category={image.category}
            aria-label={`Открыть фотографию: ${image.alt}`}
          >
            <PropertyImage image={image} sizes={index === 0 ? "(min-width: 900px) 70vw, 100vw" : "(min-width: 900px) 30vw, 50vw"} />
          </button>
        ))
      }
      <button class="all-photos" type="button" data-open-gallery="0">
        Все фотографии
        <span>{images.length}</span>
      </button>
    </div>

    <div class="mobile-strip" aria-label="Галерея дома">
      {
        images.map((image, index) => (
          <button
            class="strip-item"
            type="button"
            data-open-gallery={index}
            data-category={image.category}
            aria-label={`Открыть фотографию: ${image.alt}`}
          >
            <PropertyImage image={image} sizes="80vw" />
          </button>
        ))
      }
    </div>
  </div>

  <dialog class="lightbox" id="lightbox" aria-label="Просмотр фотографий">
    <div class="lightbox-bar">
      <p class="counter" data-lightbox-counter>1 / {images.length}</p>
      <button type="button" class="icon-btn" data-lightbox-close aria-label="Закрыть галерею">
        Закрыть
      </button>
    </div>
    <div class="lightbox-stage">
      <button type="button" class="nav-btn prev" data-lightbox-prev aria-label="Предыдущее фото">
        ‹
      </button>
      <figure>
        {
          images.map((image, index) => (
            <div class="slide" data-slide={index} hidden={index !== 0}>
              <PropertyImage image={image} sizes="100vw" />
              <figcaption>{image.alt}</figcaption>
            </div>
          ))
        }
      </figure>
      <button type="button" class="nav-btn next" data-lightbox-next aria-label="Следующее фото">
        ›
      </button>
    </div>
  </dialog>
</section>

<script>
  const images = document.querySelectorAll<HTMLElement>("[data-slide]");
  const dialog = document.getElementById("lightbox") as HTMLDialogElement | null;
  const counter = document.querySelector("[data-lightbox-counter]");
  let index = 0;
  let startX = 0;

  const emit = (name: string) => {
    window.dispatchEvent(new CustomEvent("zhitnevo:analytics", { detail: { name } }));
  };

  const show = (next: number, source?: "next" | "previous" | "open") => {
    if (!images.length) return;
    index = (next + images.length) % images.length;
    images.forEach((slide, i) => {
      slide.hidden = i !== index;
    });
    if (counter) counter.textContent = `${index + 1} / ${images.length}`;
    if (source === "next") emit("gallery_next");
    if (source === "previous") emit("gallery_previous");
  };

  const open = (next = 0) => {
    show(next);
    dialog?.showModal();
    emit("open_gallery");
  };

  const close = () => dialog?.close();

  document.querySelectorAll<HTMLElement>("[data-open-gallery]").forEach((button) => {
    button.addEventListener("click", () => open(Number(button.dataset.openGallery || 0)));
  });

  document.querySelector("[data-lightbox-close]")?.addEventListener("click", close);
  document.querySelector("[data-lightbox-next]")?.addEventListener("click", () => show(index + 1, "next"));
  document.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => show(index - 1, "previous"));

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) close();
  });

  document.addEventListener("keydown", (event) => {
    if (!dialog?.open) return;
    if (event.key === "Escape") close();
    if (event.key === "ArrowRight") show(index + 1, "next");
    if (event.key === "ArrowLeft") show(index - 1, "previous");
  });

  dialog?.addEventListener("touchstart", (event) => {
    startX = event.changedTouches[0]?.clientX ?? 0;
  }, { passive: true });

  dialog?.addEventListener("touchend", (event) => {
    const endX = event.changedTouches[0]?.clientX ?? 0;
    const delta = endX - startX;
    if (Math.abs(delta) < 40) return;
    if (delta < 0) show(index + 1, "next");
    else show(index - 1, "previous");
  });

  const tiles = document.querySelectorAll<HTMLElement>("[data-category]");
  document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter ?? "all";
      document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((item) => {
        const active = item === button;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-pressed", String(active));
      });
      tiles.forEach((tile) => {
        const visible = filter === "all" || tile.dataset.category === filter;
        tile.toggleAttribute("hidden", !visible);
      });
      const firstVisible = document.querySelector<HTMLElement>(
        `.strip-item[data-category]:not([hidden]), .tile[data-category]:not([hidden])`,
      );
      const allButton = document.querySelector<HTMLButtonElement>(".all-photos");
      if (allButton && firstVisible?.dataset.openGallery) {
        allButton.dataset.openGallery = firstVisible.dataset.openGallery;
      }
    });
  });
</script>

<style>
  .intro {
    display: grid;
    gap: 0.8rem;
    margin-bottom: var(--space-6);
    max-width: 38rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .filter {
    min-height: 40px;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-stone);
    font-size: 0.85rem;
  }

  .filter.is-active {
    background: var(--color-olive);
    border-color: var(--color-olive);
    color: var(--color-cream);
  }

  .mosaic {
    display: none;
    grid-template-columns: 1.5fr 1fr;
    grid-template-rows: repeat(2, minmax(12rem, 22rem));
    gap: 0.75rem;
    position: relative;
  }

  .tile {
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-paper);
  }

  .tile :global(img),
  .tile :global(.placeholder) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .tile:hover :global(img) {
    transform: scale(1.03);
  }

  .tile-main {
    grid-row: 1 / span 2;
  }

  .all-photos {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    min-height: 48px;
    padding: 0 1rem;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-cream);
    color: var(--color-ink);
    font-weight: 600;
  }

  .all-photos span {
    margin-left: 0.4rem;
    color: var(--color-stone);
  }

  .mobile-strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 82%;
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.4rem;
    -webkit-overflow-scrolling: touch;
  }

  .strip-item {
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--color-paper);
    scroll-snap-align: start;
  }

  .strip-item :global(.placeholder),
  .strip-item :global(img) {
    aspect-ratio: 4 / 3;
    height: auto;
  }

  .lightbox {
    width: min(100%, 92rem);
    max-width: 100%;
    height: min(100%, 100vh);
    max-height: 100vh;
    margin: auto;
    padding: 1rem;
    border: 0;
    background: rgba(27, 26, 23, 0.94);
    color: var(--color-cream);
  }

  .lightbox::backdrop {
    background: rgba(27, 26, 23, 0.72);
  }

  .lightbox-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .lightbox-stage {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.5rem;
    align-items: center;
    min-height: calc(100vh - 6rem);
  }

  figure {
    margin: 0;
  }

  .slide :global(img),
  .slide :global(.placeholder) {
    width: 100%;
    max-height: 72vh;
    object-fit: contain;
    background: #1b1a17;
  }

  figcaption {
    margin-top: 0.75rem;
    color: rgba(251, 247, 240, 0.72);
    text-align: center;
  }

  .icon-btn,
  .nav-btn {
    min-width: 44px;
    min-height: 44px;
    border: 1px solid rgba(251, 247, 240, 0.2);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-cream);
  }

  .nav-btn {
    font-size: 1.8rem;
    line-height: 1;
  }

  @media (min-width: 900px) {
    .mosaic {
      display: grid;
    }

    .mobile-strip {
      display: none;
    }
  }

  @media (max-width: 899px) {
    .lightbox-stage {
      grid-template-columns: 1fr;
    }

    .nav-btn {
      display: none;
    }
  }
</style>
