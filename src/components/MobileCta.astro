---
import { getTelUrl, getWhatsAppUrl, property } from "../config/property";
---

<div class="mobile-cta" role="navigation" aria-label="Быстрый контакт">
  <a class="call" href={getTelUrl()} data-analytics="click_phone" aria-label={`Позвонить ${property.ownerName}`}>
    Позвонить
  </a>
  <a
    class="wa"
    href={getWhatsAppUrl()}
    target="_blank"
    rel="noopener noreferrer"
    data-analytics="click_whatsapp"
    aria-label={`Написать ${property.ownerName} в WhatsApp`}
  >
    WhatsApp
  </a>
</div>

<style>
  .mobile-cta {
    display: none;
  }

  @media (max-width: 767px) {
    .mobile-cta {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 35;
      display: grid;
      grid-template-columns: 1fr 1fr;
      padding: 0.55rem 0.7rem calc(0.55rem + env(safe-area-inset-bottom, 0px));
      background: rgba(251, 247, 240, 0.94);
      border-top: 1px solid var(--color-line);
      backdrop-filter: blur(16px);
    }

    a {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      border-radius: var(--radius-pill);
      font-weight: 600;
      text-decoration: none;
    }

    .call {
      background: var(--color-graphite);
      color: var(--color-cream);
      margin-right: 0.35rem;
    }

    .wa {
      background: var(--color-olive);
      color: var(--color-cream);
      margin-left: 0.35rem;
    }
  }
</style>
