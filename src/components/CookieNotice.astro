---
import { hasMetrika } from "../config/site";

const enabled = hasMetrika();
---

{
  enabled && (
    <div class="cookie" id="cookie-notice" hidden>
      <p>
        На сайте используются cookie для анализа посещаемости. Подробнее — в{" "}
        <a href="/privacy">Политике конфиденциальности</a>.
      </p>
      <button type="button" class="btn btn-primary" id="cookie-accept">
        Понятно
      </button>
    </div>
  )
}

<script>
  const root = document.getElementById("cookie-notice");
  const button = document.getElementById("cookie-accept");
  if (root && button) {
    const key = "zhitnevo-cookie-ok";
    if (!localStorage.getItem(key)) {
      root.hidden = false;
    }
    button.addEventListener("click", () => {
      localStorage.setItem(key, "1");
      root.hidden = true;
    });
  }
</script>

<style>
  .cookie {
    position: fixed;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    align-items: center;
    width: min(32rem, calc(100% - 2rem));
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-white);
    box-shadow: var(--shadow-soft);
  }

  .cookie[hidden] {
    display: none;
  }

  .cookie p {
    flex: 1 1 14rem;
    color: var(--color-stone);
    font-size: 0.9rem;
  }

  .cookie a {
    color: var(--color-olive);
  }

  @media (max-width: 767px) {
    .cookie {
      bottom: calc(var(--mobile-cta-h) + 0.75rem + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
