---
import { getDisplayAddress, property } from "../config/property";

const { lat, lon, zoom } = property.map;
const mapSrc = `https://yandex.ru/map-widget/v1/?ll=${lon}%2C${lat}&z=${zoom}&l=map`;
const address = getDisplayAddress();
---

<section class="section location" id="location" data-view-analytics="view_location" aria-labelledby="location-title">
  <div class="container">
    <p class="eyebrow">Расположение</p>
    <h2 id="location-title">Житнево — Домодедово, Московская область</h2>
    <p class="lead">
      Дом расположен в деревне Житнево Домодедовского городского округа Московской области, ориентировочно в 35 км от МКАД.
    </p>
    <p class="address">{address}</p>
    <p class="note">На карте показан район деревни, без точного номера дома.</p>
  </div>
  <div class="map-wrap container-wide">
    <iframe
      title="Карта деревни Житнево, Домодедовский городской округ"
      src={mapSrc}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  </div>
</section>

<style>
  h2 {
    max-width: 16ch;
    margin-bottom: 0.9rem;
    font-size: var(--text-4xl);
  }

  .lead,
  .address,
  .note {
    max-width: 40rem;
  }

  .address {
    margin-top: 1rem;
    font-weight: 600;
  }

  .note {
    margin: 0.4rem 0 var(--space-6);
    color: var(--color-stone);
    font-size: 0.92rem;
  }

  .map-wrap {
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-paper);
    aspect-ratio: 16 / 10;
  }

  iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 699px) {
    .map-wrap {
      aspect-ratio: 4 / 5;
    }
  }
</style>
